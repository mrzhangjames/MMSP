<?xml version="1.0" encoding="utf-8" ?>
<!-- 日志目录由 LogHelper 设到 logDir（Data\Log）。按业务分文件夹，按天建目录，按小时写文件。 -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">
  <targets>
    <target name="run" xsi:type="File"
            fileName="${var:logDir}/运行日志/${date:format=yyyyMMdd}/${date:format=HH}.log"
            layout="${message}"
            encoding="utf-8"
            writeBom="false"
            lineEnding="LF"
            keepFileOpen="false"
            concurrentWrites="true"
            createDirs="true" />
    <target name="device" xsi:type="File"
            fileName="${var:logDir}/设备日志/${date:format=yyyyMMdd}/${date:format=HH}.log"
            layout="${message}"
            encoding="utf-8"
            writeBom="false"
            lineEnding="LF"
            keepFileOpen="false"
            concurrentWrites="true"
            createDirs="true" />
    <target name="flow" xsi:type="File"
            fileName="${var:logDir}/流程日志/${date:format=yyyyMMdd}/${date:format=HH}.log"
            layout="${message}"
            encoding="utf-8"
            writeBom="false"
            lineEnding="LF"
            keepFileOpen="false"
            concurrentWrites="true"
            createDirs="true" />
    <target name="mes" xsi:type="File"
            fileName="${var:logDir}/MES日志/${date:format=yyyyMMdd}/${date:format=HH}.log"
            layout="${message}"
            encoding="utf-8"
            writeBom="false"
            lineEnding="LF"
            keepFileOpen="false"
            concurrentWrites="true"
            createDirs="true" />
  </targets>
  <rules>
    <logger name="MMSP.Run" minlevel="Trace" writeTo="run" final="true" />
    <logger name="MMSP.Device" minlevel="Trace" writeTo="device" final="true" />
    <logger name="MMSP.Flow" minlevel="Trace" writeTo="flow" final="true" />
    <logger name="MMSP.Mes" minlevel="Trace" writeTo="mes" final="true" />
  </rules>
</nlog>
