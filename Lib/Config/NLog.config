<?xml version="1.0" encoding="utf-8" ?>
<!-- 日志按日期写到 logDir。LogHelper 启动时把 logDir 设为程序目录上一层的 Data\Log。 -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">
  <targets>
    <target name="day" xsi:type="File"
            fileName="${var:logDir}/${date:format=yyyyMMdd}.log"
            layout="${message}"
            encoding="utf-8"
            writeBom="false"
            lineEnding="LF"
            keepFileOpen="false"
            concurrentWrites="true"
            createDirs="true" />
  </targets>
  <rules>
    <logger name="MMSP" minlevel="Trace" writeTo="day" />
  </rules>
</nlog>
