<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  深色主题覆盖。只换会随主题变的画刷，金色和底栏灰不动。  -->

    <!--  画刷 HighestBlack：深色正文。  -->
    <SolidColorBrush x:Key="HighestBlack">#F0F0F0</SolidColorBrush>
    <!--  画刷 MediumNormalGray：深色次级文字。  -->
    <SolidColorBrush x:Key="MediumNormalGray">#A3A3A3</SolidColorBrush>
    <!--  画刷 MediumLightGray：深色更次要文字。  -->
    <SolidColorBrush x:Key="MediumLightGray">#8A8A8A</SolidColorBrush>
    <!--  画刷 LowerGray：深色提示文字。  -->
    <SolidColorBrush x:Key="LowerGray">#777777</SolidColorBrush>
    <!--  画刷 NavSelectedBackground：深色导航选中底。  -->
    <SolidColorBrush x:Key="NavSelectedBackground">#3F3514</SolidColorBrush>
    <!--  画刷 PageBackground：深色内容区底。  -->
    <SolidColorBrush x:Key="PageBackground">#1F1F1F</SolidColorBrush>
    <!--  画刷 CardBorderBrush：深色卡片边。  -->
    <SolidColorBrush x:Key="CardBorderBrush">#3A3A3A</SolidColorBrush>
    <!--  画刷 CardBodyBrush：深色卡片内底。  -->
    <SolidColorBrush x:Key="CardBodyBrush">#1A1A1A</SolidColorBrush>
    <!--  画刷 CardBackground：深色卡片底。  -->
    <SolidColorBrush x:Key="CardBackground">#2A2A2A</SolidColorBrush>
    <!--  画刷 HeaderDividerBrush：深色标题分割线。  -->
    <SolidColorBrush x:Key="HeaderDividerBrush">#3A3A3A</SolidColorBrush>
    <!--  画刷 FieldLabelBrush：深色字段标题。  -->
    <SolidColorBrush x:Key="FieldLabelBrush">#B0B0B0</SolidColorBrush>
</ResourceDictionary>
