<UserControl x:Class="MMSP.Plugin.Tool.Views.PlcWriteToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{DynamicResource HighestBlack}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  字典 工具表单 ToolForm。样式 ToolLabel、ToolBox、ToolCombo。  -->
                <ResourceDictionary Source="pack://application:,,,/MMSP.Plugin.Tool;component/Themes/ToolForm.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--  区域 PLC 写入。控件：名称 Name、数据源 Points.Source、点位 Points.Choice、数据类型 DataType、取值 ValueMode、写入值 Value。样式 ToolLabel、ToolBox、ToolCombo。  -->
    <StackPanel Margin="16">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="名称" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="数据源" Style="{StaticResource ToolLabel}" />
                <ComboBox Style="{StaticResource ToolCombo}"
                          ItemsSource="{Binding Points.Sources}"
                          SelectedItem="{Binding Points.Source}"
                          DisplayMemberPath="Text" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="点位" Style="{StaticResource ToolLabel}" />
                <ComboBox Style="{StaticResource ToolCombo}"
                          ItemsSource="{Binding Points.Choices}"
                          SelectedItem="{Binding Points.Choice}"
                          DisplayMemberPath="Text" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="数据类型" Style="{StaticResource ToolLabel}" />
                <ComboBox Style="{StaticResource ToolCombo}"
                          ItemsSource="{Binding DataTypes}"
                          SelectedItem="{Binding DataType}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="写入值" Style="{StaticResource ToolLabel}" />
                <Grid MinWidth="300" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource ToolCombo}"
                              ItemsSource="{Binding ValueModes}"
                              SelectedItem="{Binding ValueMode}"
                              VerticalAlignment="Center" />
                    <TextBox Grid.Column="2"
                             Style="{StaticResource ToolBox}"
                             MinWidth="160"
                             IsReadOnly="{Binding ValueFromVariable}"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
    </StackPanel>
</UserControl>
