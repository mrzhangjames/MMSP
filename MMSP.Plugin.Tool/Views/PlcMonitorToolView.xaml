<UserControl x:Class="MMSP.Plugin.Tool.Views.PlcMonitorToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{DynamicResource HighestBlack}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  字典 工具表单 ToolForm。样式 ToolLabel、ToolBox、ToolCombo、ToolCheck。  -->
                <ResourceDictionary Source="pack://application:,,,/MMSP.Plugin.Tool;component/Themes/ToolForm.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--  区域 PLC 监听。控件：名称 Name、地址 Address、数据类型 DataType、长度 Length、期望值 ExpectValue、重置 Reset、间隔 Interval、重置值 ResetValue。样式 ToolLabel、ToolBox、ToolCombo、ToolCheck。  -->
    <StackPanel Margin="16">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="名称" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="地址" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="数据类型" Style="{StaticResource ToolLabel}" />
                <ComboBox Style="{StaticResource ToolCombo}"
                          ItemsSource="{Binding DataTypes}"
                          SelectedItem="{Binding DataType}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="长度" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="期望值" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding ExpectValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToolCheck}"
                      Content="重置"
                      IsChecked="{Binding Reset}"
                      Margin="0,0,0,12" />
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="间隔" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="重置值" Style="{StaticResource ToolLabel}" />
                <TextBox Style="{StaticResource ToolBox}"
                         Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
    </StackPanel>
</UserControl>
