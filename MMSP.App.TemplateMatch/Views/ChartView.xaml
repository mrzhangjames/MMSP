<UserControl x:Class="MMSP.App.TemplateMatch.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource CardBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{DynamicResource HighestBlack}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="ChartToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6E6E6" />
                    <Setter Property="BorderBrush" Value="#BDBDBD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChartLineButton" TargetType="Button" BasedOn="{StaticResource ChartToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLine}" Value="True">
                    <Setter Property="Background" Value="#FFF6D2" />
                    <Setter Property="BorderBrush" Value="#FCC800" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChartColumnButton" TargetType="Button" BasedOn="{StaticResource ChartToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsColumn}" Value="True">
                    <Setter Property="Background" Value="#FFF6D2" />
                    <Setter Property="BorderBrush" Value="#FCC800" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChartPieButton" TargetType="Button" BasedOn="{StaticResource ChartToolButton}">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPie}" Value="True">
                    <Setter Property="Background" Value="#FFF6D2" />
                    <Setter Property="BorderBrush" Value="#FCC800" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChartUnderlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="CaretBrush" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Line"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,4,0,4" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBox"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="#FFF6D2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChartComboItem}" />
            <Setter Property="MaxDropDownHeight" Value="160" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Line"
                                                Background="Transparent"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,4,0,4"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="&#x25BE;"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FieldLabelBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartCardItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                MinHeight="120"
                                Margin="0,0,0,12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="#E4E4E4"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="18,16" />
                                <Border x:Name="Bar"
                                        Height="4"
                                        VerticalAlignment="Bottom"
                                        Background="#FCC800"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#E0D7B0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFF6D2" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFF6D2" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFA" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FAFAF8">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChartToolButton}"
                            Command="{Binding AddCommand}"
                            AutomationProperties.AutomationId="ChartAddButton"
                            AutomationProperties.Name="{DynamicResource User_Add}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource User_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChartToolButton}"
                            Command="{Binding EditCommand}"
                            AutomationProperties.AutomationId="ChartEditButton"
                            AutomationProperties.Name="{DynamicResource User_Edit}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="PencilSimple" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource User_Edit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChartToolButton}"
                            Margin="0"
                            Command="{Binding DeleteCommand}"
                            AutomationProperties.AutomationId="ChartDeleteButton"
                            AutomationProperties.Name="{DynamicResource User_Delete}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource User_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Charts}"
                     SelectedItem="{Binding SelectedChart}"
                     ItemContainerStyle="{StaticResource ChartCardItem}"
                     BorderThickness="0"
                     Background="#FAFAF8"
                     Padding="16,16,16,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.AutomationId="ChartCardList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       Foreground="#888888"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="13"
                                       Margin="0,8,0,0"
                                       Foreground="{Binding SubtitleBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.RowSpan="2" BorderBrush="#E4E4E4" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
        </Grid>

        <Grid x:Name="ChartRight" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{Binding DataContext.DataPaneLength, ElementName=ChartRight}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="16,0">
                    <DockPanel LastChildFill="False">
                        <Border Width="3" Height="16" Background="#FCC800" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedName}"
                                   Margin="8,0,0,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ChartLineButton}"
                                    Command="{Binding SetKindCommand}"
                                    CommandParameter="Line"
                                    AutomationProperties.AutomationId="ChartLineButton">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="ChartLine" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Chart_Line}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChartColumnButton}"
                                    Command="{Binding SetKindCommand}"
                                    CommandParameter="Column"
                                    AutomationProperties.AutomationId="ChartColumnButton">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="ChartBar" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Chart_Column}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChartPieButton}"
                                    Command="{Binding SetKindCommand}"
                                    CommandParameter="Pie"
                                    AutomationProperties.AutomationId="ChartPieButton">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="ChartPie" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Chart_Pie}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Margin="8,8,16,12">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPie}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <lvc:CartesianChart Series="{Binding CartesianSeries}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"
                                            ZoomMode="None"
                                            Background="Transparent" />
                    </Grid>
                    <lvc:PieChart Series="{Binding PieSeries}"
                                  LegendPosition="Right"
                                  TooltipPosition="Top"
                                  Background="Transparent"
                                  Visibility="{Binding IsPie, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="16,0">
                    <DockPanel LastChildFill="False">
                        <Border Width="3" Height="16" Background="#FCC800" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Chart_Data}"
                                   Margin="8,0,0,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ChartToolButton}"
                                MinWidth="72"
                                Margin="0"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleDataCommand}"
                                AutomationProperties.AutomationId="ChartCollapseButton">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Width="16" Height="16" VerticalAlignment="Center">
                                    <iconPacks:PackIconPhosphorIcons.Style>
                                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                            <Setter Property="Kind" Value="CaretDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDataOpen}" Value="False">
                                                    <Setter Property="Kind" Value="CaretUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconPhosphorIcons.Style>
                                </iconPacks:PackIconPhosphorIcons>
                                <TextBlock Text="{Binding CollapseText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="16,0" Visibility="{Binding IsDataOpen, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ChartToolButton}"
                                Margin="8,0,0,0"
                                Command="{Binding QueryCommand}"
                                AutomationProperties.AutomationId="ChartQueryButton">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="MagnifyingGlass" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Chart_Query}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Height="32" BorderBrush="#CCCCCC" BorderThickness="1" Background="{DynamicResource CardBackground}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconPhosphorIcons Kind="MagnifyingGlass"
                                                                 Width="16"
                                                                 Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#B0B0B0" />
                                <TextBox Grid.Column="1"
                                         Margin="8,0,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ChartSearchBox">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding QueryCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#B0B0B0"
                                           IsHitTestVisible="False"
                                           Text="{DynamicResource Chart_SearchHint}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="2" Visibility="{Binding IsDataOpen, Converter={StaticResource BoolVis}}">
                    <DataGrid ItemsSource="{Binding Points}"
                              Visibility="{Binding IsUph, Converter={StaticResource BoolVis}}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              BorderThickness="0"
                              Background="{DynamicResource CardBackground}"
                              RowBackground="{DynamicResource CardBackground}"
                              AlternatingRowBackground="#FAFAFA"
                              AlternationCount="2"
                              RowHeight="32"
                              ColumnHeaderHeight="32"
                              FontSize="14"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource ChartGridRow}"
                              CellStyle="{StaticResource ChartGridCell}"
                              ColumnHeaderStyle="{StaticResource ChartGridHeader}"
                              AutomationProperties.AutomationId="ChartDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Chart_Time}" Width="140" Binding="{Binding TimeText}" />
                            <DataGridTextColumn Header="{DynamicResource Chart_HourOutput}" Width="*" Binding="{Binding HourOutputText}" />
                            <DataGridTextColumn Header="{DynamicResource Chart_TotalOutput}" Width="*" Binding="{Binding TotalOutputText}" />
                            <DataGridTextColumn Header="{DynamicResource Chart_GoodCount}" Width="*" Binding="{Binding GoodCountText}" />
                            <DataGridTextColumn Header="{DynamicResource Chart_DefectCount}" Width="*" Binding="{Binding DefectCountText}" />
                            <DataGridTextColumn Header="{DynamicResource Chart_Yield}" Width="*" Binding="{Binding YieldText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMes, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding MesSourceName}"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasMesSource, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{DynamicResource Chart_MesEmpty}"
                                   HorizontalAlignment="Center"
                                   Foreground="#888888" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Background="#73000000"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolVis}}"
              AutomationProperties.AutomationId="ChartEditor">
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,0">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="ChartEditorTitle" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="24,18,24,8">
                        <TextBlock Text="{DynamicResource Chart_Name}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,4" />
                        <Grid>
                            <TextBox Style="{StaticResource ChartUnderlineBox}"
                                     MaxLength="16"
                                     Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ChartEditorName" />
                            <TextBlock Text="{DynamicResource Chart_NameHint}"
                                       Margin="0,0,0,2"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorName}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{DynamicResource Chart_SourceKind}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                        <ComboBox Style="{StaticResource ChartCombo}"
                                  ItemsSource="{Binding SourceKinds}"
                                  SelectedItem="{Binding EditorSourceKind}"
                                  AutomationProperties.AutomationId="ChartEditorSourceKind" />

                        <TextBlock Text="{DynamicResource Chart_Source}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                        <Grid>
                            <TextBox Style="{StaticResource ChartUnderlineBox}"
                                     MaxLength="64"
                                     Text="{Binding EditorSource, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ChartEditorSource" />
                            <TextBlock Text="{DynamicResource Chart_SourceHint}"
                                       Margin="0,0,0,2"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorSource}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{DynamicResource Chart_Display}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                        <Grid>
                            <TextBox Style="{StaticResource ChartUnderlineBox}"
                                     MaxLength="12"
                                     Text="{Binding EditorDisplay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ChartEditorDisplay" />
                            <TextBlock Text="{DynamicResource Chart_DisplayHint}"
                                       Margin="0,0,0,2"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorDisplay}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{DynamicResource Chart_Subtitle}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                        <Grid>
                            <TextBox Style="{StaticResource ChartUnderlineBox}"
                                     MaxLength="24"
                                     Text="{Binding EditorSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ChartEditorSubtitle" />
                            <TextBlock Text="{DynamicResource Chart_SubtitleHint}"
                                       Margin="0,0,0,2"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorSubtitle}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{DynamicResource Chart_SubtitleStyle}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                        <ComboBox Style="{StaticResource ChartCombo}"
                                  ItemsSource="{Binding SubtitleStyles}"
                                  SelectedItem="{Binding EditorSubtitleStyle}"
                                  AutomationProperties.AutomationId="ChartEditorSubtitleStyle" />

                        <TextBlock Text="{Binding EditorError}"
                                   Foreground="{StaticResource HighestRed}"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ChartEditorError">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditorError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <Button Style="{StaticResource ChartToolButton}"
                                Command="{Binding ConfirmCommand}"
                                AutomationProperties.AutomationId="ChartEditorSave">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource User_Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChartToolButton}"
                                Margin="0"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="ChartEditorCancel">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource User_Cancel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
