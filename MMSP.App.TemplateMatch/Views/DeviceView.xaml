<UserControl x:Class="MMSP.App.TemplateMatch.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:model="clr-namespace:MMSP.App.TemplateMatch.Models"
             xmlns:local="clr-namespace:MMSP.App.TemplateMatch.Views"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{StaticResource CardBodyBrush}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{StaticResource HighestBlack}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="DeviceToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MediumNormalGray}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceUnderlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="CaretBrush" Value="{StaticResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Line"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,4,0,2" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBox"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="#FFF6D2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DeviceComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Line" BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,4,0,2"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="&#x25BE;"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="#666666"
                                                           FontSize="12" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceCheckCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DeviceGridCellStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DeviceGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFA" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceLogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DeviceLogTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MediumNormalGray}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding DirectionText}" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DirectionText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:DeviceLogKind.Send}">
                                    <Setter Property="Foreground" Value="#8A6A00" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:DeviceLogKind.Receive}">
                                    <Setter Property="Foreground" Value="#2F9E4F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:DeviceLogKind.Timeout}">
                                    <Setter Property="Foreground" Value="#CE3D3A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource HighestBlack}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="PointMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Box"
                                Height="32"
                                Margin="0,0,0,6"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,8,0" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F2F2F2" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button Command="{Binding ShowPlcCommand}"
                            AutomationProperties.AutomationId="DevicePlcTab"
                            AutomationProperties.Name="{StaticResource Device_Plc}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DeviceTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcPage}" Value="True">
                                        <Setter Property="Background" Value="#FFF6D2" />
                                        <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="Monitor" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Device_Plc}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowScannerCommand}"
                            AutomationProperties.AutomationId="DeviceScannerTab"
                            AutomationProperties.Name="{StaticResource Device_Scanner}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DeviceTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerPage}" Value="True">
                                        <Setter Property="Background" Value="#FFF6D2" />
                                        <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="Barcode" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource Device_Scanner}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid Visibility="{Binding IsPlcPage, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="8,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Command="{Binding ShowPlcConfigCommand}"
                                            AutomationProperties.AutomationId="DeviceConfigTab"
                                            AutomationProperties.Name="{StaticResource Device_Config}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DeviceTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlcConfigTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFF6D2" />
                                                        <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{StaticResource Device_Config}" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Command="{Binding ShowPlcTestCommand}"
                                            AutomationProperties.AutomationId="DeviceTestTab"
                                            AutomationProperties.Name="{StaticResource Device_Test}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DeviceTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlcTestTab}" Value="True">
                                                        <Setter Property="Background" Value="#FFF6D2" />
                                                        <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{StaticResource Device_Test}" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding IsPlcConfigTab, Converter={StaticResource BoolVis}}">
                                <UniformGrid Columns="2" Margin="18,14,18,8">
                                    <StackPanel Margin="0,0,16,12">
                                        <TextBlock Text="{StaticResource Device_Ip}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcIp, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{StaticResource Device_ConnType}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding PlcConnectionType}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,12">
                                        <TextBlock Text="{StaticResource Device_Port}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcPort, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{StaticResource Device_DataFormat}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding DataFormats}" SelectedItem="{Binding PlcDataFormat}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,12">
                                        <TextBlock Text="{StaticResource Device_Poll}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcPoll, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{StaticResource Device_ReadTimeout}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcReadTimeout, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,12">
                                        <TextBlock Text="{StaticResource Device_WriteTimeout}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcWriteTimeout, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{StaticResource Device_ReconnectInterval}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcReconnectInterval, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,12">
                                        <TextBlock Text="{StaticResource Device_ReconnectCount}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding PlcReconnectCount, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </UniformGrid>
                            </ScrollViewer>
                            <Grid Grid.Row="1" Visibility="{Binding IsPlcTestTab, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="0" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <UniformGrid Columns="2" Margin="18,14,18,0">
                                        <StackPanel Margin="0,0,16,12">
                                            <TextBlock Text="{StaticResource Device_Address}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding TestAddress, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{StaticResource Device_DataType}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding TestDataType}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,4">
                                            <TextBlock Text="{StaticResource Device_Length}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding TestLength, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="{StaticResource Device_WriteValue}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding TestWriteValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,8,18,8">
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding ReadCustomCommand}"
                                            AutomationProperties.AutomationId="DeviceReadButton"
                                            AutomationProperties.Name="{StaticResource Device_Read}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Device_Read}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Command="{Binding WriteCustomCommand}"
                                            AutomationProperties.AutomationId="DeviceWriteButton"
                                            AutomationProperties.Name="{StaticResource Device_Write}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Device_Write}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border Grid.Row="2" Margin="18,0,18,14" Background="{StaticResource CardBodyBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{StaticResource Device_CurrentValue}" FontSize="12" Foreground="{StaticResource MediumNormalGray}" />
                                        <TextBlock Text="{Binding CurrentValue}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CurrentDetail}" FontSize="12" Foreground="{StaticResource MediumNormalGray}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{StaticResource Device_PlcLog}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding PlcLogs}"
                                     ItemTemplate="{StaticResource DeviceLogTemplate}"
                                     ItemContainerStyle="{StaticResource DeviceLogItem}"
                                     BorderThickness="0"
                                     Background="White"
                                     Padding="14,8"
                                     FontFamily="Consolas, Microsoft YaHei"
                                     FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{StaticResource Device_Points}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding AddPointCommand}"
                                            AutomationProperties.AutomationId="DevicePointAdd">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource User_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding EditPointCommand}"
                                            AutomationProperties.AutomationId="DevicePointEdit">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="PencilSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource User_Edit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DeletePointCommand}"
                                            AutomationProperties.AutomationId="DevicePointDelete">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource User_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding ImportPointsCommand}"
                                            AutomationProperties.AutomationId="DevicePointImport"
                                            AutomationProperties.Name="{StaticResource Device_Import}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="FileArrowDown" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Device_Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Command="{Binding ExportPointsCommand}"
                                            AutomationProperties.AutomationId="DevicePointExport"
                                            AutomationProperties.Name="{StaticResource Device_Export}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="FileArrowUp" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Device_Export}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="PointGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Points}"
                                  SelectedItem="{Binding SelectedPoint}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  AlternationCount="2"
                                  RowHeight="36"
                                  ColumnHeaderHeight="36"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowStyle="{StaticResource DeviceGridRowStyle}"
                                  CellStyle="{StaticResource DeviceGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource DeviceGridHeaderStyle}"
                                  PreviewMouseRightButtonDown="OnPointRightClick"
                                  MouseDoubleClick="OnPointDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Placement="MousePoint"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Background="White"
                                             BorderBrush="#CCCCCC"
                                             BorderThickness="1"
                                             Padding="6,6,6,0">
                                    <MenuItem Header="{StaticResource Device_Read}"
                                              Style="{StaticResource PointMenuItem}"
                                              Command="{Binding ReadPointCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" Foreground="{StaticResource HighestBlack}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{StaticResource Device_Write}"
                                              Style="{StaticResource PointMenuItem}"
                                              Command="{Binding WritePointCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="16" Height="16" Foreground="{StaticResource HighestBlack}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header=""
                                                        Width="46"
                                                        Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                        CellStyle="{StaticResource DeviceCheckCellStyle}" />
                                <DataGridTextColumn Header="{StaticResource Device_PointName}" Width="*" Binding="{Binding Name}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{StaticResource Device_Address}" Width="140" Binding="{Binding Address}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{StaticResource Device_DataType}" Width="140" Binding="{Binding DataType}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{StaticResource Device_Length}" Width="90" Binding="{Binding LengthText}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{StaticResource Device_Access}" Width="100" Binding="{Binding AccessText}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="{StaticResource Device_On}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" Padding="6,0" Height="20">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F6EC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EnabledText}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2F9E4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="#888888" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsScannerPage, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DeviceToolButtonStyle}"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddScannerCommand}"
                                        AutomationProperties.AutomationId="DeviceScannerAdd">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource User_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DeviceToolButtonStyle}"
                                        Margin="0,0,8,0"
                                        Command="{Binding EditScannerCommand}"
                                        AutomationProperties.AutomationId="DeviceScannerEdit">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="PencilSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource User_Edit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DeviceToolButtonStyle}"
                                        Command="{Binding DeleteScannerCommand}"
                                        AutomationProperties.AutomationId="DeviceScannerDelete">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource User_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Scanners}"
                                 SelectedItem="{Binding SelectedScanner}"
                                 BorderThickness="0"
                                 Background="{StaticResource CardBodyBrush}"
                                 Padding="16,16,16,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnScannerDoubleClick" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="Card"
                                                            MinHeight="132"
                                                            Background="White"
                                                            BorderBrush="{StaticResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16,14">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <Border x:Name="Bar" Height="4" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="0,0,8,8" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#FFF6D2" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FFF6D2" />
                                                        <Setter TargetName="Bar" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                                            <Border HorizontalAlignment="Right" Padding="6,0" Height="20" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F6EC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EnabledText}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2F9E4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="#888888" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock FontSize="13" Foreground="{StaticResource MediumNormalGray}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{StaticResource Device_Ip}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTcp}" Value="False">
                                                                <Setter Property="Text" Value="{StaticResource Device_Com}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Ip}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsTcp, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{StaticResource Device_Port}" FontSize="13" Foreground="{StaticResource MediumNormalGray}" />
                                            <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="{StaticResource Device_TriggerText}" FontSize="13" Foreground="{StaticResource MediumNormalGray}" />
                                            <TextBlock Text="{Binding TriggerText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{StaticResource Device_TriggerRead}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="20,16,20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="2" IsHitTestVisible="False">
                                    <StackPanel Margin="0,0,20,14">
                                        <TextBlock Text="{StaticResource Device_Scanner}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.Name}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock FontSize="12" Foreground="#666666" Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{StaticResource Device_Ip}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedScanner.IsTcp}" Value="False">
                                                            <Setter Property="Text" Value="{StaticResource Device_Com}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.Ip}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,0" Visibility="{Binding SelectedScanner.IsTcp, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{StaticResource Device_Port}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.Port}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{StaticResource Device_TriggerText}" FontSize="12" Foreground="#666666" Margin="0,0,0,2" />
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.TriggerText}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Command="{Binding TriggerCommand}"
                                            AutomationProperties.AutomationId="DeviceTriggerButton"
                                            AutomationProperties.Name="{StaticResource Device_Trigger}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Device_Trigger}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                            <TextBlock Text="{StaticResource Device_ScanResult}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,12">
                                            <local:BarcodeBlock Text="{Binding ScanResult}" Height="72" />
                                        </Border>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding ScanResult}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   AutomationProperties.AutomationId="DeviceScanResult" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{StaticResource Device_ScanLog}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ScanLogs}"
                                     ItemTemplate="{StaticResource DeviceLogTemplate}"
                                     ItemContainerStyle="{StaticResource DeviceLogItem}"
                                     BorderThickness="0"
                                     Background="White"
                                     Padding="16,10"
                                     FontFamily="Consolas, Microsoft YaHei"
                                     FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.RowSpan="2"
              Background="#2E333333"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolVis}}"
              AutomationProperties.AutomationId="DeviceEditor">
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,0">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="24,18,24,8">
                        <StackPanel Visibility="{Binding IsPointEditor, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{StaticResource Device_PointName}" FontSize="12" Foreground="#666666" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{StaticResource Device_Address}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{StaticResource Device_DataType}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding EditorDataType}" />
                            <TextBlock Text="{StaticResource Device_Length}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorLength, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{StaticResource Device_Access}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding AccessModes}" SelectedItem="{Binding EditorAccess}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsScannerEditor, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{StaticResource Device_ScannerName}" FontSize="12" Foreground="#666666" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{StaticResource Device_Transport}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding ScanTransports}" SelectedItem="{Binding EditorTransport}" />
                            <TextBlock FontSize="12" Foreground="#666666" Margin="0,14,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{StaticResource Device_Ip}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditorTcp}" Value="False">
                                                <Setter Property="Text" Value="{StaticResource Device_Com}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorIp, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Visibility="{Binding IsEditorTcp, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{StaticResource Device_Port}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                                <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Text="{StaticResource Device_TriggerText}" FontSize="12" Foreground="#666666" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorTrigger, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Margin="0,16,0,0"
                                  Content="{StaticResource Device_On}"
                                  IsChecked="{Binding EditorEnabled}"
                                  Foreground="{StaticResource HighestBlack}" />
                        <TextBlock Text="{Binding EditorError}" Margin="0,10,0,0" Foreground="#CE3D3A" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <Button Style="{StaticResource DeviceToolButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding ConfirmEditorCommand}"
                                AutomationProperties.AutomationId="DeviceEditorSave">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{StaticResource User_Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeviceToolButtonStyle}"
                                Command="{Binding CancelEditorCommand}"
                                AutomationProperties.AutomationId="DeviceEditorCancel">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{StaticResource User_Cancel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
