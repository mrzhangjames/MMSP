<UserControl x:Class="MMSP.App.TemplateMatch.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:model="clr-namespace:MMSP.App.TemplateMatch.Models"
             xmlns:base="clr-namespace:MMSP.App.WpfBase.Services;assembly=MMSP.App.WpfBase"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource CardBodyBrush}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{DynamicResource HighestBlack}">
    <UserControl.Resources>
        <!--  转换 BoolVis：布尔到可见性。  -->
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!--  样式 DeviceToolButtonStyle：工具按钮。白底灰边，悬停变灰。  -->
        <Style x:Key="DeviceToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 DevicePageTab：PLC 与扫码枪页签。顶栏靠左，选中浅金底，底部 3 像素金线。  -->
        <Style x:Key="DevicePageTab" TargetType="TabItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MediumNormalGray}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  样式 DeviceTabButtonStyle：页签按钮。选中色由各按钮自己加。  -->
        <Style x:Key="DeviceTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MediumNormalGray}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 DeviceUnderlineBox：下划线输入框。  -->
        <Style x:Key="DeviceUnderlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="CaretBrush" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Line"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,0,1" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 DeviceComboItem：下拉项。悬停浅金，选中金色。  -->
        <Style x:Key="DeviceComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBox"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="#FFF6D2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 DeviceFieldBox：配置和测试里的输入框。比编辑窗更矮，避免把文字裁掉。  -->
        <Style x:Key="DeviceFieldBox" TargetType="TextBox" BasedOn="{StaticResource DeviceUnderlineBox}">
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!--  样式 DeviceCombo：下划线下拉框。条目用 DeviceComboItem。  -->
        <Style x:Key="DeviceCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DeviceComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          Style="{x:Null}"
                                          MinHeight="0"
                                          MinWidth="0"
                                          Padding="0"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Line"
                                                Background="Transparent"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="0,0,0,2"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,0,0,1"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="&#x25BE;"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FieldLabelBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,1,1,1"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 DeviceFieldCombo：配置和测试里的下拉框。高度与 DeviceFieldBox 一致。  -->
        <Style x:Key="DeviceFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource DeviceCombo}">
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!--  样式 DeviceGridHeaderStyle：点位表格列头。  -->
        <Style x:Key="DeviceGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 DeviceGridCellStyle：点位表格单元格。选中为金色。  -->
        <Style x:Key="DeviceGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  样式 DeviceCheckCellStyle：点位勾选列。基于 DeviceGridCellStyle。  -->
        <Style x:Key="DeviceCheckCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DeviceGridCellStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!--  样式 DeviceGridRowStyle：点位表格行。隔行浅灰，勾选或选中为金色。  -->
        <Style x:Key="DeviceGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFA" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  样式 DeviceLogItem：日志行容器。PLC 日志另改为左对齐，长文才能横向滚动。  -->
        <Style x:Key="DeviceLogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  模板 DeviceLogTemplate：一条日志。控件为时间、方向、内容。  -->
        <DataTemplate x:Key="DeviceLogTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MediumNormalGray}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding DirectionText}" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DirectionText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:DeviceLogKind.Send}">
                                    <Setter Property="Foreground" Value="#8A6A00" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:DeviceLogKind.Receive}">
                                    <Setter Property="Foreground" Value="#2F9E4F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:DeviceLogKind.Timeout}">
                                    <Setter Property="Foreground" Value="#CE3D3A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource HighestBlack}" />
            </StackPanel>
        </DataTemplate>

        <!--  样式 PointMenuItem：点位右键菜单项。  -->
        <Style x:Key="PointMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Box"
                                Height="32"
                                Margin="0,0,0,6"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,8,0" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F2F2F2" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  区域 页签。页签 PLC（DevicePlcTab）、扫码枪（DeviceScannerTab）靠左，版式与流程页 FlowTab 相同。样式 DevicePageTab。  -->
        <TabControl ItemContainerStyle="{StaticResource DevicePageTab}"
                    TabStripPlacement="Top"
                    Background="{DynamicResource CardBackground}"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource HeaderDividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0,8,0">
                            <TabPanel IsItemsHost="True"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <!--  页签 PLC（DevicePlcTab）。  -->
            <TabItem AutomationProperties.AutomationId="DevicePlcTab"
                     AutomationProperties.Name="{DynamicResource Device_Plc}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="Monitor" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Device_Plc}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            <!--  区域 PLC 页。左列连接与日志，右列点位。  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" MinHeight="260" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <!--  区域 PLC 连接卡片。页签：配置（DeviceConfigTab）、测试（DeviceTestTab）。  -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="8,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <!--  按钮 配置。命令 ShowPlcConfigCommand。样式 DeviceTabButtonStyle。  -->
                                    <Button Command="{Binding ShowPlcConfigCommand}"
                                            AutomationProperties.AutomationId="DeviceConfigTab"
                                            AutomationProperties.Name="{DynamicResource Device_Config}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DeviceTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlcConfigTab}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{DynamicResource Device_Config}" VerticalAlignment="Center" />
                                    </Button>
                                    <!--  按钮 测试。命令 ShowPlcTestCommand。样式 DeviceTabButtonStyle。  -->
                                    <Button Command="{Binding ShowPlcTestCommand}"
                                            AutomationProperties.AutomationId="DeviceTestTab"
                                            AutomationProperties.Name="{DynamicResource Device_Test}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DeviceTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlcTestTab}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{DynamicResource Device_Test}" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!--  区域 PLC 配置。控件：IP、连接类型、端口、数据格式、轮询、读超时、写超时、重连间隔、重连次数。样式 DeviceFieldBox、DeviceFieldCombo。不滚动。  -->
                            <Grid Grid.Row="1"
                                  Margin="16,4,16,4"
                                  Visibility="{Binding IsPlcConfigTab, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_Ip}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcIp, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_ConnType}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <ComboBox Style="{StaticResource DeviceFieldCombo}" ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding PlcConnectionType}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_Port}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcPort, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_DataFormat}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <ComboBox Style="{StaticResource DeviceFieldCombo}" ItemsSource="{Binding DataFormats}" SelectedItem="{Binding PlcDataFormat}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_Poll}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcPoll, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_ReadTimeout}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcReadTimeout, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_WriteTimeout}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcWriteTimeout, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_ReconnectInterval}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcReconnectInterval, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_ReconnectCount}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding PlcReconnectCount, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <!--  区域 PLC 测试。控件：地址、数据类型、长度、写入值。样式 DeviceFieldBox、DeviceFieldCombo。不滚动。  -->
                            <Grid Grid.Row="1"
                                  Margin="16,4,16,6"
                                  Visibility="{Binding IsPlcTestTab, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_Address}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding TestAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_DataType}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <ComboBox Style="{StaticResource DeviceFieldCombo}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding TestDataType}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_Length}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding TestLength, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Device_WriteValue}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                                    <TextBox Style="{StaticResource DeviceFieldBox}" Text="{Binding TestWriteValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <!--  按钮 读取（DeviceReadButton）、写入（DeviceWriteButton）。样式 DeviceToolButtonStyle。  -->
                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,4">
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Command="{Binding ReadCustomCommand}"
                                            AutomationProperties.AutomationId="DeviceReadButton"
                                            AutomationProperties.Name="{DynamicResource Device_Read}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Device_Read}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Height="28"
                                            Command="{Binding WriteCustomCommand}"
                                            AutomationProperties.AutomationId="DeviceWriteButton"
                                            AutomationProperties.Name="{DynamicResource Device_Write}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Device_Write}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!--  区域 当前值。控件 CurrentValue、CurrentDetail。  -->
                                <Border Grid.Row="3"
                                        Grid.ColumnSpan="3"
                                        Background="{DynamicResource CardBodyBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="12,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Device_CurrentValue}" FontSize="12" Foreground="{DynamicResource MediumNormalGray}" />
                                        <TextBlock Text="{Binding CurrentValue}" FontSize="20" FontWeight="Bold" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding CurrentDetail}" FontSize="12" Foreground="{DynamicResource MediumNormalGray}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  区域 PLC 日志。控件 PlcLogs，模板 DeviceLogTemplate。横向滚动条 Auto。卡片上边距 10。  -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{DynamicResource Device_PlcLog}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding PlcLogs}"
                                     ItemTemplate="{StaticResource DeviceLogTemplate}"
                                     BorderThickness="0"
                                     Background="{DynamicResource CardBackground}"
                                     Padding="14,8"
                                     FontFamily="Consolas, Microsoft YaHei"
                                     FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceLogItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!--  区域 点位。按钮：新增、编辑、删除、导入、导出。样式 DeviceToolButtonStyle。  -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{DynamicResource Device_Points}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding AddPointCommand}"
                                            AutomationProperties.AutomationId="DevicePointAdd">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource User_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding EditPointCommand}"
                                            AutomationProperties.AutomationId="DevicePointEdit">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="PencilSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource User_Edit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DeletePointCommand}"
                                            AutomationProperties.AutomationId="DevicePointDelete">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource User_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding ImportPointsCommand}"
                                            AutomationProperties.AutomationId="DevicePointImport"
                                            AutomationProperties.Name="{DynamicResource Device_Import}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="FileArrowDown" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Device_Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Command="{Binding ExportPointsCommand}"
                                            AutomationProperties.AutomationId="DevicePointExport"
                                            AutomationProperties.Name="{DynamicResource Device_Export}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="FileArrowUp" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Device_Export}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!--  控件 PointGrid：点位表。列：勾选、名称、地址、数据类型、长度、读写、启用。样式 DeviceGridRowStyle、DeviceGridCellStyle、DeviceGridHeaderStyle。  -->
                        <DataGrid x:Name="PointGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Points}"
                                  SelectedItem="{Binding SelectedPoint}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBackground}"
                                  RowBackground="{DynamicResource CardBackground}"
                                  AlternatingRowBackground="#FAFAFA"
                                  AlternationCount="2"
                                  RowHeight="36"
                                  ColumnHeaderHeight="36"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowStyle="{StaticResource DeviceGridRowStyle}"
                                  CellStyle="{StaticResource DeviceGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource DeviceGridHeaderStyle}"
                                  PreviewMouseRightButtonDown="OnPointRightClick"
                                  MouseDoubleClick="OnPointDoubleClick">
                            <!--  菜单 点位右键。项：读取、写入。样式 PointMenuItem。  -->
                            <DataGrid.ContextMenu>
                                <ContextMenu Placement="MousePoint"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Background="{DynamicResource CardBackground}"
                                             BorderBrush="#CCCCCC"
                                             BorderThickness="1"
                                             Padding="6,6,6,0">
                                    <MenuItem Header="{DynamicResource Device_Read}"
                                              Style="{StaticResource PointMenuItem}"
                                              Command="{Binding ReadPointCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" Foreground="{DynamicResource HighestBlack}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Device_Write}"
                                              Style="{StaticResource PointMenuItem}"
                                              Command="{Binding WritePointCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="16" Height="16" Foreground="{DynamicResource HighestBlack}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header=""
                                                        Width="46"
                                                        Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                        CellStyle="{StaticResource DeviceCheckCellStyle}" />
                                <DataGridTextColumn Header="{DynamicResource Device_PointName}" Width="*" Binding="{Binding Name}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource Device_Address}" Width="140" Binding="{Binding Address}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource Device_DataType}" Width="140" Binding="{Binding DataType}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource Device_Length}" Width="90" Binding="{Binding LengthText}" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource Device_Access}" Width="100" Binding="{Binding AccessText}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="{DynamicResource Device_On}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" Padding="6,0" Height="20">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F6EC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EnabledText}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2F9E4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="#888888" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
            </TabItem>
            <!--  页签 扫码枪（DeviceScannerTab）。  -->
            <TabItem AutomationProperties.AutomationId="DeviceScannerTab"
                     AutomationProperties.Name="{DynamicResource Device_Scanner}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="Barcode" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Device_Scanner}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            <!--  区域 扫码枪页。左列枪列表，右列触发读取和扫码日志。  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  区域 扫码枪列表。按钮：新增（DeviceScannerAdd）、编辑（DeviceScannerEdit）、删除（DeviceScannerDelete）。样式 DeviceToolButtonStyle。  -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DeviceToolButtonStyle}"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddScannerCommand}"
                                        AutomationProperties.AutomationId="DeviceScannerAdd">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource User_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DeviceToolButtonStyle}"
                                        Margin="0,0,8,0"
                                        Command="{Binding EditScannerCommand}"
                                        AutomationProperties.AutomationId="DeviceScannerEdit">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="PencilSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource User_Edit}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DeviceToolButtonStyle}"
                                        Command="{Binding DeleteScannerCommand}"
                                        AutomationProperties.AutomationId="DeviceScannerDelete">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource User_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!--  控件 扫码枪卡片列表。绑定 Scanners、SelectedScanner。双击打开编辑。  -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Scanners}"
                                 SelectedItem="{Binding SelectedScanner}"
                                 BorderThickness="0"
                                 Background="{DynamicResource CardBodyBrush}"
                                 Padding="16,16,16,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnScannerDoubleClick" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="Card"
                                                            MinHeight="132"
                                                            Background="{DynamicResource CardBackground}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="16,14">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <Border x:Name="Bar" Height="4" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="0,0,8,8" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#FFF6D2" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FFF6D2" />
                                                        <Setter TargetName="Bar" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                                            <Border HorizontalAlignment="Right" Padding="6,0" Height="20" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F6EC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EnabledText}" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2F9E4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="#888888" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource MediumNormalGray}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource Device_Ip}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTcp}" Value="False">
                                                                <Setter Property="Text" Value="{DynamicResource Device_Com}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Ip}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsTcp, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{DynamicResource Device_Port}" FontSize="13" Foreground="{DynamicResource MediumNormalGray}" />
                                            <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="{DynamicResource Device_TriggerText}" FontSize="13" Foreground="{DynamicResource MediumNormalGray}" />
                                            <TextBlock Text="{Binding TriggerText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  区域 触发读取。只读控件：枪名、IP 或 COM、端口、触发字符串。扫码结果的条码和文字在同一张卡片里。  -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{DynamicResource Device_TriggerRead}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="20,16,20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="2" IsHitTestVisible="False">
                                    <StackPanel Margin="0,0,20,14">
                                        <TextBlock Text="{DynamicResource Device_Scanner}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.Name}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Device_Ip}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedScanner.IsTcp}" Value="False">
                                                            <Setter Property="Text" Value="{DynamicResource Device_Com}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.Ip}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,0" Visibility="{Binding SelectedScanner.IsTcp, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{DynamicResource Device_Port}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.Port}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Device_TriggerText}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Height="30">
                                            <TextBlock Text="{Binding SelectedScanner.TriggerText}" FontSize="15" VerticalAlignment="Center" Margin="0,4,0,2" />
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>
                                <!--  按钮 触发（DeviceTriggerButton）。样式 DeviceToolButtonStyle。命令 TriggerCommand。  -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Style="{StaticResource DeviceToolButtonStyle}"
                                            Command="{Binding TriggerCommand}"
                                            AutomationProperties.AutomationId="DeviceTriggerButton"
                                            AutomationProperties.Name="{DynamicResource Device_Trigger}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Device_Trigger}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!--  控件 扫码结果。条码 BarcodeBlock，文字 DeviceScanResult，都绑 ScanResult。  -->
                                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,12">
                                        <base:BarcodeBlock Text="{Binding ScanResult}" Height="72" />
                                    </Border>
                                    <TextBlock Text="{Binding ScanResult}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               AutomationProperties.AutomationId="DeviceScanResult" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <!--  区域 扫码日志。控件 ScanLogs，模板 DeviceLogTemplate，行样式 DeviceLogItem。  -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{DynamicResource Device_ScanLog}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ScanLogs}"
                                     ItemTemplate="{StaticResource DeviceLogTemplate}"
                                     ItemContainerStyle="{StaticResource DeviceLogItem}"
                                     BorderThickness="0"
                                     Background="{DynamicResource CardBackground}"
                                     Padding="16,10"
                                     FontFamily="Consolas, Microsoft YaHei"
                                     FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </TabItem>
        </TabControl>

        <!--  区域 编辑窗 DeviceEditor。点位或扫码枪字段。按钮：保存（DeviceEditorSave）、取消（DeviceEditorCancel）。样式 DeviceToolButtonStyle。  -->
        <Grid Background="#2E333333"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolVis}}"
              AutomationProperties.AutomationId="DeviceEditor">
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,0">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="24,18,24,8">
                        <!--  区域 点位编辑。控件：名称、地址、数据类型、长度、读写。样式 DeviceUnderlineBox、DeviceCombo。  -->
                        <StackPanel Visibility="{Binding IsPointEditor, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{DynamicResource Device_PointName}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{DynamicResource Device_Address}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{DynamicResource Device_DataType}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding EditorDataType}" />
                            <TextBlock Text="{DynamicResource Device_Length}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorLength, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{DynamicResource Device_Access}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding AccessModes}" SelectedItem="{Binding EditorAccess}" />
                        </StackPanel>
                        <!--  区域 扫码枪编辑。控件：名称、传输、IP 或 COM、端口、触发字符串。样式 DeviceUnderlineBox、DeviceCombo。  -->
                        <StackPanel Visibility="{Binding IsScannerEditor, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{DynamicResource Device_ScannerName}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{DynamicResource Device_Transport}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource DeviceCombo}" ItemsSource="{Binding ScanTransports}" SelectedItem="{Binding EditorTransport}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Device_Ip}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditorTcp}" Value="False">
                                                <Setter Property="Text" Value="{DynamicResource Device_Com}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorIp, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Visibility="{Binding IsEditorTcp, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{DynamicResource Device_Port}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                                <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Device_TriggerText}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource DeviceUnderlineBox}" Text="{Binding EditorTrigger, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  控件 启用。绑定 EditorEnabled。  -->
                        <CheckBox Margin="0,16,0,0"
                                  Content="{DynamicResource Device_On}"
                                  IsChecked="{Binding EditorEnabled}"
                                  Foreground="{DynamicResource HighestBlack}" />
                        <TextBlock Text="{Binding EditorError}" Margin="0,10,0,0" Foreground="#CE3D3A" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <Button Style="{StaticResource DeviceToolButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding ConfirmEditorCommand}"
                                AutomationProperties.AutomationId="DeviceEditorSave">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource User_Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeviceToolButtonStyle}"
                                Command="{Binding CancelEditorCommand}"
                                AutomationProperties.AutomationId="DeviceEditorCancel">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource User_Cancel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
