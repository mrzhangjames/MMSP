<UserControl x:Class="MMSP.App.TemplateMatch.Views.FlowView"
             x:Name="FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource CardBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{DynamicResource HighestBlack}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <ItemsPanelTemplate x:Key="FlowToolPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="FlowToolCard">
            <Border MinHeight="56"
                    Margin="3"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel VerticalAlignment="Center">
                    <iconPacks:PackIconPhosphorIcons Kind="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="6,4,6,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="FlowToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="20">
                            <Border x:Name="Track" Background="#CCCCCC" CornerRadius="10" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowUnderlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="CaretBrush" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Line"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,4,0,2" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowEndpointBox" TargetType="TextBox" BasedOn="{StaticResource FlowUnderlineBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent"
                                BorderBrush="{StaticResource ThemeBrushColorAssist}"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,4,0,2" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBox" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="#FFF6D2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBox" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FlowComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Line" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,4,0,2"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="&#x25BE;"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FieldLabelBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  与设备页页签相同：顶栏横排，选中浅金底，底部 3 像素金线。  -->
        <Style x:Key="FlowTab" TargetType="TabItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MediumNormalGray}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF6D2" />
                    <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
    <TabControl ItemContainerStyle="{StaticResource FlowTab}"
                TabStripPlacement="Top"
                SelectedIndex="{Binding PageIndex}"
                Background="{DynamicResource CardBackground}"
                BorderThickness="0"
                Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource HeaderDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0,8,0">
                        <TabPanel IsItemsHost="True"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom" />
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Grid.Row="1"
                                      ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabItem AutomationProperties.AutomationId="FlowDataTab"
                 AutomationProperties.Name="{DynamicResource Flow_Data}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="FlowArrow" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Flow_Data}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Padding="10,0" Background="{DynamicResource CardBackground}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding AddCommand}" AutomationProperties.AutomationId="FlowAdd" AutomationProperties.Name="{DynamicResource Flow_Add}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="FlowDelete" AutomationProperties.Name="{DynamicResource Flow_Delete}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding RunCommand}" AutomationProperties.AutomationId="FlowRun" AutomationProperties.Name="{DynamicResource Flow_Run}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Run}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding CopyCommand}" AutomationProperties.AutomationId="FlowCopy" AutomationProperties.Name="{DynamicResource Flow_Copy}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Copy" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding ExportCommand}" AutomationProperties.AutomationId="FlowExport" AutomationProperties.Name="{DynamicResource Flow_Export}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Export}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlowToolButton}" Margin="0" Command="{Binding ImportCommand}" AutomationProperties.AutomationId="FlowImport" AutomationProperties.Name="{DynamicResource Flow_Import}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource CardBodyBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Flows}" Margin="12,12,12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True"
                                            PreviewMouseLeftButtonDown="OnFlowCardPreviewMouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource NavSelectedBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <StackPanel Margin="12,8,12,8">
                                                <Button Style="{StaticResource FlowFlatButton}"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="FlowCard">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{DynamicResource Flow_StepCount}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StepCount}" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                                <Grid Height="20" Margin="0,4,0,0">
                                                    <Button Style="{StaticResource FlowFlatButton}"
                                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{DynamicResource Flow_Enabled}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <ToggleButton HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource FlowSwitch}"
                                                                  IsChecked="{Binding IsEnabled}" />
                                                </Grid>
                                                <Grid Height="20" Margin="0,4,0,0">
                                                    <Button Style="{StaticResource FlowFlatButton}"
                                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{DynamicResource Flow_Log}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <ToggleButton HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource FlowSwitch}"
                                                                  IsChecked="{Binding LogOutput}" />
                                                </Grid>
                                            </StackPanel>
                                            <Border Height="4" VerticalAlignment="Bottom" Background="{StaticResource ThemeBrushColorAssist}" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <DockPanel Grid.Column="1" Background="{DynamicResource CardBackground}" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Width="1" Background="{DynamicResource CardBorderBrush}" />
                    <Border DockPanel.Dock="Top" Height="48" BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Left" Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Flow_Tools}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,4,8,8">
                            <TextBlock Text="{DynamicResource Flow_ToolGeneral}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MediumNormalGray}"
                                       Margin="4,6,4,2" />
                            <ItemsControl ItemsSource="{Binding GeneralTools}"
                                          ItemsPanel="{StaticResource FlowToolPanel}"
                                          ItemTemplate="{StaticResource FlowToolCard}"
                                          dd:DragDrop.IsDragSource="True" />
                            <TextBlock Text="{Binding CustomerToolGroup}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MediumNormalGray}"
                                       Margin="4,8,4,2"
                                       Visibility="{Binding HasCustomerTools, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding CustomerTools}"
                                          ItemsPanel="{StaticResource FlowToolPanel}"
                                          ItemTemplate="{StaticResource FlowToolCard}"
                                          dd:DragDrop.IsDragSource="True"
                                          Visibility="{Binding HasCustomerTools, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </ScrollViewer>
            </DockPanel>

            <DockPanel Grid.Column="2" Background="{DynamicResource CardBodyBrush}" LastChildFill="True">
                <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Left" Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Flow_Column}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Flow_Order}" FontSize="12" Foreground="{DynamicResource MediumNormalGray}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="StepScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ItemsControl ItemsSource="{Binding SelectedFlow.Steps}"
                                  Background="Transparent"
                                  Padding="12,10,12,8"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="{Binding ViewportHeight, ElementName=StepScroll}"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid PreviewMouseLeftButtonDown="OnStepPreviewMouseDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Border Width="2" HorizontalAlignment="Center" Background="{DynamicResource CardBorderBrush}" Margin="0,22,0,0" Visibility="{Binding ShowStem, Converter={StaticResource BoolVis}}" />
                                        <Border Width="22" Height="22" VerticalAlignment="Top" CornerRadius="11" Background="{StaticResource ThemeBrushColorAssist}">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Border Grid.Column="2"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowStem}" Value="False">
                                                        <Setter Property="Margin" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource MahApps.Styles.ContextMenu}">
                                                <MenuItem Header="{DynamicResource Flow_Property}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.ShowPropertyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{DynamicResource Flow_Delete}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <Border MinWidth="52" Height="20" Padding="6,0" CornerRadius="2" Background="{DynamicResource NavSelectedBackground}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Detail}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Detail}" Value="">
                                                                    <Setter Property="Text" Value="{DynamicResource Flow_Unconfigured}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
        </TabItem>
        <TabItem AutomationProperties.AutomationId="FlowMesTab"
                 AutomationProperties.Name="{DynamicResource Flow_MesTitle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="ShareNetwork" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Flow_MesTitle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <Grid Background="{DynamicResource CardBodyBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Border Margin="12"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        AutomationProperties.AutomationId="FlowMesDialog">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="14,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlowToolButton}"
                                            Command="{Binding SaveMesCommand}"
                                            AutomationProperties.AutomationId="FlowMesSave"
                                            AutomationProperties.Name="{DynamicResource Config_Save}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Config_Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FlowToolButton}"
                                            Margin="0"
                                            Command="{Binding CancelMesCommand}"
                                            AutomationProperties.AutomationId="FlowMesCancel"
                                            AutomationProperties.Name="{DynamicResource User_Cancel}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource User_Cancel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{DynamicResource Flow_MesTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="18,14,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Flow_Endpoint}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                    <TextBox Style="{StaticResource FlowEndpointBox}"
                                             Text="{Binding DraftEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FlowMesEndpoint" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Flow_Station}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                    <TextBox Style="{StaticResource FlowUnderlineBox}"
                                             Text="{Binding DraftStation, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FlowMesStation" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Flow_Timeout}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                    <TextBox Style="{StaticResource FlowUnderlineBox}"
                                             Text="{Binding DraftTimeout, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FlowMesTimeout" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Flow_Retry}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                    <TextBox Style="{StaticResource FlowUnderlineBox}"
                                             Text="{Binding DraftRetry, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FlowMesRetry" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Flow_Enabled}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2" />
                                    <ComboBox Style="{StaticResource FlowCombo}"
                                              ItemsSource="{Binding EnabledChoices}"
                                              SelectedItem="{Binding DraftEnabled}"
                                              AutomationProperties.AutomationId="FlowMesEnabled" />
                                </StackPanel>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding MesError}"
                                           Foreground="{StaticResource HighestRed}"
                                           FontSize="12"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="FlowMesError">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MesError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</UserControl>
