<UserControl x:Class="MMSP.App.TemplateMatch.Views.FlowView"
             x:Name="FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource CardBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{DynamicResource HighestBlack}">
    <UserControl.Resources>
        <!--  转换 BoolVis：布尔到可见性。  -->
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <!--  模板 FlowToolPanel：工具卡片两列面板。  -->
        <ItemsPanelTemplate x:Key="FlowToolPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <!--  模板 FlowToolCard：工具卡片。图标和名称。  -->
        <DataTemplate x:Key="FlowToolCard">
            <Border MinHeight="56"
                    Margin="3"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel VerticalAlignment="Center">
                    <iconPacks:PackIconPhosphorIcons Kind="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="6,4,6,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  样式 FlowToolButton：工具按钮。白底灰边，悬停变灰。  -->
        <Style x:Key="FlowToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 FlowFlatButton：透明按钮。无边框，内容拉满。  -->
        <Style x:Key="FlowFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 FlowSwitch：开关。未选为灰轨，选中为金轨且圆点靠右。  -->
        <Style x:Key="FlowSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="20">
                            <Border x:Name="Track" Background="#CCCCCC" CornerRadius="10" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 FlowUnderlineBox：下划线输入框。聚焦时底边变金。  -->
        <Style x:Key="FlowUnderlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="CaretBrush" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Line"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,4,0,2" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 FlowCheck：MES 布尔勾选框。选中为金色。  -->
        <Style x:Key="FlowCheck" TargetType="CheckBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="#C8C8C8"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark"
                                      Width="10"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Stroke="{DynamicResource HighestBlack}"
                                      StrokeThickness="1.6"
                                      Data="M 1 4 L 4 7 L 9 1"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E0B400" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  样式 FlowTab：流程页签。顶栏横排，选中浅金底，底部 3 像素金线。  -->
        <Style x:Key="FlowTab" TargetType="TabItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MediumNormalGray}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
    <!--  区域 页签。绑定 PageIndex。页签：流程数据（FlowDataTab）、MES配置（FlowMesTab）。样式 FlowTab。  -->
    <TabControl ItemContainerStyle="{StaticResource FlowTab}"
                TabStripPlacement="Top"
                SelectedIndex="{Binding PageIndex}"
                Background="{DynamicResource CardBackground}"
                BorderThickness="0"
                Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource HeaderDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0,8,0">
                        <TabPanel IsItemsHost="True"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom" />
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Grid.Row="1"
                                      ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <!--  页签 流程数据（FlowDataTab）。  -->
        <TabItem AutomationProperties.AutomationId="FlowDataTab"
                 AutomationProperties.Name="{DynamicResource Flow_Data}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="FlowArrow" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Flow_Data}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
        <!--  区域 流程数据。左列流程列表，中列工具，右列步骤。  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  区域 流程列表。按钮：新增（FlowAdd）、删除（FlowDelete）、执行（FlowRun）、复制（FlowCopy）、导出（FlowExport）、导入（FlowImport）。样式 FlowToolButton。  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Padding="10,0" Background="{DynamicResource CardBackground}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!--  按钮 新增（FlowAdd）。命令 AddCommand。  -->
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding AddCommand}" AutomationProperties.AutomationId="FlowAdd" AutomationProperties.Name="{DynamicResource Flow_Add}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!--  按钮 删除（FlowDelete）。命令 DeleteCommand。  -->
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="FlowDelete" AutomationProperties.Name="{DynamicResource Flow_Delete}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Trash" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!--  按钮 执行（FlowRun）。命令 RunCommand。  -->
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding RunCommand}" AutomationProperties.AutomationId="FlowRun" AutomationProperties.Name="{DynamicResource Flow_Run}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Run}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!--  按钮 复制（FlowCopy）。命令 CopyCommand。  -->
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding CopyCommand}" AutomationProperties.AutomationId="FlowCopy" AutomationProperties.Name="{DynamicResource Flow_Copy}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="Copy" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!--  按钮 导出（FlowExport）。命令 ExportCommand。  -->
                        <Button Style="{StaticResource FlowToolButton}" Command="{Binding ExportCommand}" AutomationProperties.AutomationId="FlowExport" AutomationProperties.Name="{DynamicResource Flow_Export}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Export}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!--  按钮 导入（FlowImport）。命令 ImportCommand。  -->
                        <Button Style="{StaticResource FlowToolButton}" Margin="0" Command="{Binding ImportCommand}" AutomationProperties.AutomationId="FlowImport" AutomationProperties.Name="{DynamicResource Flow_Import}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Flow_Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource CardBodyBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!--  控件 流程卡片列表。绑定 Flows。  -->
                        <ItemsControl ItemsSource="{Binding Flows}" Margin="12,12,12,4">
                            <ItemsControl.ItemTemplate>
                                <!--  模板 流程卡片项：一条流程。名称、流程步数量、启用（IsEnabled）、日志输出（LogOutput）。按钮用 FlowFlatButton，开关用 FlowSwitch。  -->
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            PreviewMouseRightButtonDown="OnFlowCardPreviewMouseRightButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource NavSelectedBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!--  菜单 流程卡片右键。项：流程编辑（EditCommand）、变量编辑（EditVarsCommand）。单击只选中，不打开名称窗。  -->
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource MahApps.Styles.ContextMenu}">
                                                <MenuItem Header="{DynamicResource Flow_FlowEdit}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{DynamicResource Flow_VarEdit}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.EditVarsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <StackPanel Margin="12,8,12,8">
                                                <!--  按钮 流程卡片（FlowCard）。命令 SelectCommand。  -->
                                                <Button Style="{StaticResource FlowFlatButton}"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="FlowCard">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{DynamicResource Flow_StepCount}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StepCount}" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                                <Grid Height="20" Margin="0,4,0,0">
                                                    <!--  按钮 选择流程。命令 SelectCommand。  -->
                                                    <Button Style="{StaticResource FlowFlatButton}"
                                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{DynamicResource Flow_Enabled}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <ToggleButton HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource FlowSwitch}"
                                                                  IsChecked="{Binding IsEnabled}" />
                                                </Grid>
                                                <Grid Height="20" Margin="0,4,0,0">
                                                    <!--  按钮 选择流程。命令 SelectCommand。  -->
                                                    <Button Style="{StaticResource FlowFlatButton}"
                                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{DynamicResource Flow_Log}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <ToggleButton HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource FlowSwitch}"
                                                                  IsChecked="{Binding LogOutput}" />
                                                </Grid>
                                            </StackPanel>
                                            <Border Height="4" VerticalAlignment="Bottom" Background="{StaticResource ThemeBrushColorAssist}" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--  区域 工具。标题：工具。分组：通用、客户工具（CustomerToolGroup）。模板 FlowToolPanel、FlowToolCard。  -->
            <DockPanel Grid.Column="1" Background="{DynamicResource CardBackground}" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Width="1" Background="{DynamicResource CardBorderBrush}" />
                    <Border DockPanel.Dock="Top" Height="48" BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Left" Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Flow_Tools}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,4,8,8">
                            <TextBlock Text="{DynamicResource Flow_ToolGeneral}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MediumNormalGray}"
                                       Margin="4,6,4,2" />
                            <!--  控件 通用工具。绑定 GeneralTools。可拖出。模板 FlowToolPanel、FlowToolCard。  -->
                            <ItemsControl ItemsSource="{Binding GeneralTools}"
                                          ItemsPanel="{StaticResource FlowToolPanel}"
                                          ItemTemplate="{StaticResource FlowToolCard}"
                                          dd:DragDrop.IsDragSource="True" />
                            <TextBlock Text="{Binding CustomerToolGroup}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MediumNormalGray}"
                                       Margin="4,8,4,2"
                                       Visibility="{Binding HasCustomerTools, Converter={StaticResource BoolVis}}" />
                            <!--  控件 客户工具。绑定 CustomerTools、HasCustomerTools。可拖出。模板 FlowToolPanel、FlowToolCard。  -->
                            <ItemsControl ItemsSource="{Binding CustomerTools}"
                                          ItemsPanel="{StaticResource FlowToolPanel}"
                                          ItemTemplate="{StaticResource FlowToolCard}"
                                          dd:DragDrop.IsDragSource="True"
                                          Visibility="{Binding HasCustomerTools, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </ScrollViewer>
            </DockPanel>

            <!--  区域 流程步骤。标题：流程。提示：由上向下依次执行。控件：步骤列表。  -->
            <DockPanel Grid.Column="2" Background="{DynamicResource CardBodyBrush}" LastChildFill="True">
                <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Left" Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Flow_Column}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Flow_Order}" FontSize="12" Foreground="{DynamicResource MediumNormalGray}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="StepScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <!--  控件 步骤列表。绑定 SelectedFlow.Steps。可拖入工具，步骤也可拖动。  -->
                    <ItemsControl ItemsSource="{Binding SelectedFlow.Steps}"
                                  Background="Transparent"
                                  Padding="12,10,12,8"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="{Binding ViewportHeight, ElementName=StepScroll}"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <!--  模板 步骤项：序号、类型、标题、说明、执行状态。耗时在卡片右侧末尾。说明为空时显示未配置。  -->
                            <DataTemplate>
                                <Grid PreviewMouseLeftButtonDown="OnStepPreviewMouseDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Border Width="2" HorizontalAlignment="Center" Background="{DynamicResource CardBorderBrush}" Margin="0,22,0,0" Visibility="{Binding ShowStem, Converter={StaticResource BoolVis}}" />
                                        <Border Width="22" Height="22" VerticalAlignment="Top" CornerRadius="11">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    <Style.Triggers>
                                                        <!--  2 成功，3 失败，4 跳过，5 已取消。执行中仍用主题色。  -->
                                                        <DataTrigger Binding="{Binding RunKind}" Value="2">
                                                            <Setter Property="Background" Value="#2E9B4F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunKind}" Value="3">
                                                            <Setter Property="Background" Value="#C4473A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunKind}" Value="4">
                                                            <Setter Property="Background" Value="#C8C8C8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunKind}" Value="5">
                                                            <Setter Property="Background" Value="#C8C8C8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Border Grid.Column="2"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowStem}" Value="False">
                                                        <Setter Property="Margin" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <!--  菜单 步骤右键。项：单步执行（RunStepCommand）、属性（ShowPropertyCommand）、删除（DeleteStepCommand）。样式 MahApps.Styles.ContextMenu、MahApps.Styles.MenuItem。  -->
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource MahApps.Styles.ContextMenu}">
                                                <MenuItem Header="{DynamicResource Flow_RunStep}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.RunStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{DynamicResource Flow_Property}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.ShowPropertyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{DynamicResource Flow_Delete}"
                                                          Style="{StaticResource MahApps.Styles.MenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" MinWidth="52" Height="20" Padding="6,0" CornerRadius="2" Background="{DynamicResource NavSelectedBackground}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Detail}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Detail}" Value="">
                                                                    <Setter Property="Text" Value="{DynamicResource Flow_Unconfigured}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding RunStateText}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding RunDetail}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RunStateText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RunKind}" Value="1">
                                                                <Setter Property="Foreground" Value="#333333" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RunKind}" Value="2">
                                                                <Setter Property="Foreground" Value="#2E9B4F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RunKind}" Value="3">
                                                                <Setter Property="Foreground" Value="#C4473A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource MediumNormalGray}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ElapsedText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElapsedText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
        </TabItem>
        <!--  页签 MES配置（FlowMesTab）。  -->
        <TabItem AutomationProperties.AutomationId="FlowMesTab"
                 AutomationProperties.Name="{DynamicResource Flow_MesTitle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconPhosphorIcons Kind="ShareNetwork" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Flow_MesTitle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <Grid Background="{DynamicResource CardBodyBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <!--  区域 MES配置（FlowMesDialog）。按钮：保存（FlowMesSave）、取消（FlowMesCancel）。控件：MesFields 按配置类属性生成，错误 MesError。样式 FlowToolButton、FlowUnderlineBox、FlowCheck。  -->
                <Border Margin="12"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        AutomationProperties.AutomationId="FlowMesDialog">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="14,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!--  按钮 保存（FlowMesSave）。命令 SaveMesCommand。  -->
                                    <Button Style="{StaticResource FlowToolButton}"
                                            Command="{Binding SaveMesCommand}"
                                            AutomationProperties.AutomationId="FlowMesSave"
                                            AutomationProperties.Name="{DynamicResource Config_Save}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Config_Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!--  按钮 取消（FlowMesCancel）。命令 CancelMesCommand。  -->
                                    <Button Style="{StaticResource FlowToolButton}"
                                            Margin="0"
                                            Command="{Binding CancelMesCommand}"
                                            AutomationProperties.AutomationId="FlowMesCancel"
                                            AutomationProperties.Name="{DynamicResource User_Cancel}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource User_Cancel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="14" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                    <TextBlock Text="{DynamicResource Flow_MesTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,14,18,16">
                                <!--  控件 MES 字段。绑定 MesFields。文本为标题加 FlowUnderlineBox，布尔为 FlowCheck。  -->
                                <ItemsControl ItemsSource="{Binding MesFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12"
                                                        AutomationProperties.AutomationId="{Binding Name}">
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCheck}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource FlowUnderlineBox}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCheck}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding Checked, Mode=TwoWay}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource FlowCheck}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCheck}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!--  控件 错误（FlowMesError）。绑定 MesError。为空时折叠。  -->
                                <TextBlock Text="{Binding MesError}"
                                           Foreground="{StaticResource HighestRed}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="FlowMesError">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MesError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</UserControl>
