<UserControl x:Class="MMSP.App.TemplateMatch.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{StaticResource CardBodyBrush}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14"
             Foreground="{StaticResource HighestBlack}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="ConfigPanel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ConfigFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigUnderlineBox" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource HighestBlack}" />
            <Setter Property="CaretBrush" Value="{StaticResource HighestBlack}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Line"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,4,0,4" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource ConfigPanel}">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Height="52" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="16" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                <TextBlock Text="{StaticResource Config_Theme}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="18,16,18,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1" Padding="12" SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NavSelectedBackground}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{StaticResource ConfigFlatButton}"
                                        Command="{Binding SelectLightCommand}"
                                        AutomationProperties.AutomationId="ConfigThemeLight"
                                        AutomationProperties.Name="{StaticResource Config_ThemeLight}">
                                    <StackPanel>
                                        <Border Height="108" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Top" Height="16" Background="#F7F7F7" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" />
                                                <StackPanel DockPanel.Dock="Top" Height="42" Orientation="Horizontal" Background="White">
                                                    <Border Width="28" Height="18" Margin="10,12,0,0" CornerRadius="3" Background="#EEEEEE" VerticalAlignment="Top" />
                                                    <Border Width="28" Height="18" Margin="6,12,0,0" CornerRadius="3" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Top" />
                                                    <Border Width="28" Height="18" Margin="6,12,0,0" CornerRadius="3" Background="#EEEEEE" VerticalAlignment="Top" />
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource ThemeBrushColorAssist}" />
                                                <Border Background="{StaticResource PageBackground}" />
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="{StaticResource Config_ThemeLight}" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text="{StaticResource Config_Current}"
                                                       Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MediumNormalGray}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsLightTheme, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" Padding="12" SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource NavSelectedBackground}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ThemeBrushColorAssist}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{StaticResource ConfigFlatButton}"
                                        Command="{Binding SelectDarkCommand}"
                                        AutomationProperties.AutomationId="ConfigThemeDark"
                                        AutomationProperties.Name="{StaticResource Config_ThemeDark}">
                                    <StackPanel>
                                        <Border Height="108" CornerRadius="6" BorderBrush="#3A3A3A" BorderThickness="1" ClipToBounds="True">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Top" Height="16" Background="#3A3A3A" />
                                                <StackPanel DockPanel.Dock="Top" Height="42" Orientation="Horizontal" Background="#2A2A2A">
                                                    <Border Width="28" Height="18" Margin="10,12,0,0" CornerRadius="3" Background="#4A4A4A" VerticalAlignment="Top" />
                                                    <Border Width="28" Height="18" Margin="6,12,0,0" CornerRadius="3" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Top" />
                                                    <Border Width="28" Height="18" Margin="6,12,0,0" CornerRadius="3" Background="#4A4A4A" VerticalAlignment="Top" />
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource ThemeBrushColorAssist}" />
                                                <Border Background="#1F1F1F" />
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="{StaticResource Config_ThemeDark}" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text="{StaticResource Config_Current}"
                                                       Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MediumNormalGray}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ConfigPanel}">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Height="52" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="16" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                <TextBlock Text="{StaticResource Config_Language}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="18,16,18,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="76" CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChinese}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NavSelectedBackground}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource NavSelectedBackground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Button Style="{StaticResource ConfigFlatButton}"
                                            Command="{Binding SelectChineseCommand}"
                                            AutomationProperties.AutomationId="ConfigLangZh"
                                            AutomationProperties.Name="{StaticResource Config_LangZh}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{StaticResource Config_LangZh}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Config_LangZhCode}" FontSize="12" Foreground="{StaticResource MediumNormalGray}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Border Height="4" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChinese}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Height="76" CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NavSelectedBackground}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource NavSelectedBackground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Button Style="{StaticResource ConfigFlatButton}"
                                            Command="{Binding SelectEnglishCommand}"
                                            AutomationProperties.AutomationId="ConfigLangEn"
                                            AutomationProperties.Name="{StaticResource Config_LangEn}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{StaticResource Config_LangEn}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{StaticResource Config_LangEnCode}" FontSize="12" Foreground="{StaticResource MediumNormalGray}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Border Height="4" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ThemeBrushColorAssist}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ConfigPanel}">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Height="52" Padding="16,0">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Width="3" Height="16" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource Config_General}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource ConfigToolButton}"
                                        Command="{Binding SaveCommand}"
                                        AutomationProperties.AutomationId="ConfigSave"
                                        AutomationProperties.Name="{StaticResource Config_Save}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="FloppyDisk" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource Config_Save}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="18,16,18,18">
                            <TextBlock Text="{StaticResource Config_WindowTitle}" FontSize="12" Foreground="#666666" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ConfigUnderlineBox}"
                                     Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ConfigWindowTitle" />
                            <Grid Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Config_LogFolder}" FontSize="12" Foreground="#666666" Margin="0,0,0,4" />
                                    <TextBlock Text="{StaticResource Config_LogPath}" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ConfigToolButton}"
                                        Command="{Binding OpenLogCommand}"
                                        AutomationProperties.AutomationId="ConfigOpenLog"
                                        AutomationProperties.Name="{StaticResource Config_OpenLog}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource Config_OpenLog}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource ConfigPanel}">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Height="52" Padding="16,0">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Width="3" Height="16" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource Config_License}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource ConfigToolButton}"
                                        Command="{Binding ImportCommand}"
                                        AutomationProperties.AutomationId="ConfigImport"
                                        AutomationProperties.Name="{StaticResource Config_Import}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource Config_Import}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="18,8,18,8">
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_Status}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#E8F6EC" Padding="8,2">
                                        <TextBlock Text="{StaticResource Config_StatusValid}" Foreground="#2F9E4F" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_Customer}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="LD" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_Bind}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{StaticResource Config_BindMachine}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_NotBefore}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="2026-01-01" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_NotAfter}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="2027-12-31" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource Config_Modules}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource CardBodyBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,2">
                                    <TextBlock Text="MMSP.App.TemplateMatch" FontSize="13" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ConfigPanel}">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource HeaderDividerBrush}" BorderThickness="0,0,0,1" Height="52" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="16" Margin="0,0,8,0" Background="{StaticResource ThemeBrushColorAssist}" />
                                <TextBlock Text="{StaticResource Config_Version}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="18,8,18,8">
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_Product}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Config_AppVersion}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource Config_FileVersion}" Foreground="{StaticResource MediumNormalGray}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FileVersion}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
