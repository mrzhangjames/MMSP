<UserControl x:Class="MMSP.Plugin.Lux.Views.LuxAlarmLogToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,12,12,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="导入"
                        Style="{StaticResource MahApps.Styles.Button}"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Click="ImportClick" />
                <Button Content="导出"
                        Style="{StaticResource MahApps.Styles.Button}"
                        MinWidth="72"
                        Click="ExportClick" />
            </StackPanel>
            <CheckBox Content="记录日志"
                      Style="{StaticResource MahApps.Styles.CheckBox}"
                      VerticalAlignment="Center"
                      IsChecked="{Binding Log, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DataGrid x:Name="AlarmGrid"
                  Style="{StaticResource MahApps.Styles.DataGrid}"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  MinHeight="280"
                  Margin="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="地址"
                                    Width="160"
                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                    EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}" />
                <DataGridTemplateColumn Header="数据类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                       Text="{Binding DataType}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource MahApps.Styles.ComboBox.DataGrid.Editing}"
                                      ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="触发值"
                                    Width="100"
                                    Binding="{Binding TriggerValue, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                    EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}" />
                <DataGridTextColumn Header="报警描述"
                                    Width="*"
                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                    EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
