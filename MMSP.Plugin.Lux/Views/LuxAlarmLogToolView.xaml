<UserControl x:Class="MMSP.Plugin.Lux.Views.LuxAlarmLogToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
             FontFamily="Segoe UI, Microsoft YaHei"
             FontSize="14">
    <!--  区域 报警日志。按钮：导入、导出。控件：记录日志 Log、表格 AlarmGrid。列：地址、数据类型、触发值、报警描述。  -->
    <DockPanel>
        <!--  区域 工具栏。  -->
        <DockPanel DockPanel.Dock="Top" Margin="12,12,12,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!--  按钮 导入。事件 ImportClick。  -->
                <Button Style="{StaticResource MahApps.Styles.Button}"
                        MinWidth="88"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="ImportClick">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="DownloadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="导入" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!--  按钮 导出。事件 ExportClick。  -->
                <Button Style="{StaticResource MahApps.Styles.Button}"
                        MinWidth="88"
                        Height="32"
                        Click="ExportClick">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="UploadSimple" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="导出" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!--  控件 记录日志。绑定 Log。  -->
            <CheckBox Content="记录日志"
                      Style="{StaticResource MahApps.Styles.CheckBox}"
                      VerticalAlignment="Center"
                      IsChecked="{Binding Log, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <!--  控件 报警表 AlarmGrid。绑定 Rows。列：地址 Address、数据类型 DataType、触发值 TriggerValue、报警描述 Description。  -->
        <DataGrid x:Name="AlarmGrid"
                  Style="{StaticResource MahApps.Styles.DataGrid}"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  MinHeight="280"
                  Margin="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="地址"
                                    Width="160"
                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                    EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}" />
                <DataGridTemplateColumn Header="数据类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                       Text="{Binding DataType}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource MahApps.Styles.ComboBox.DataGrid.Editing}"
                                      ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="触发值"
                                    Width="100"
                                    Binding="{Binding TriggerValue, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                    EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}" />
                <DataGridTextColumn Header="报警描述"
                                    Width="*"
                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource MahApps.Styles.TextBlock.DataGrid}"
                                    EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
