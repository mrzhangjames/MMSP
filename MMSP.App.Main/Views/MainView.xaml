<mah:MetroWindow x:Class="MMSP.App.Main.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:MMSP.App.Main.Views"
        mc:Ignorable="d"
        x:Name="win"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        ShowIconOnTitleBar="True"
        Icon="/Resources/app.ico"
        ShowMaxRestoreButton="False"
        ShowMinButton="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
    
        WindowStyle="None">

    <mah:MetroWindow.Triggers />

    <mah:MetroWindow.Resources>
        <!--  样式 NavAuthButtonStyle：退出。无边框，只放图标。比导航按钮小，靠右。基于 MahApps Flat，自绘模板。  -->
        <Style x:Key="NavAuthButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
            <Setter Property="Width" Value="{StaticResource NavExitButtonWidth}" />
            <Setter Property="Height" Value="{StaticResource NavExitButtonHeight}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource HighestBlack}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <!--  顶部 菜单区域  左侧  -->
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands ShowSeparators="False">
            <!--<TextBlock VerticalAlignment="Center" Text="LD Software Platform" />-->
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <!--  顶部 菜单区域  右侧  -->
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands ShowLastSeparator="False" />
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!--  区域 导航。左列菜单，中列运行，右列退出。运行按钮不进 Menus。  -->
        <Grid Grid.Row="0"
              Height="{StaticResource NavBarHeight}"
              Background="{DynamicResource CardBackground}">
            <Grid Margin="24,17,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2"
                            Width="{StaticResource NavExitButtonWidth}"
                            Panel.ZIndex="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!--  按钮 退出。事件 OnExitClick。样式 NavAuthButtonStyle。靠右，比导航按钮小。  -->
                    <Button Style="{StaticResource NavAuthButtonStyle}"
                            Click="OnExitClick"
                            ToolTip="{DynamicResource Shell_Exit}"
                            AutomationProperties.Name="{DynamicResource Shell_Exit}">
                        <iconPacks:PackIconPhosphorIcons Kind="Power"
                                                         Width="{StaticResource NavExitIconSize}"
                                                         Height="{StaticResource NavExitIconSize}"
                                                         Foreground="{DynamicResource HighestBlack}" />
                    </Button>
                </StackPanel>

                <!--  控件 导航菜单。样式 NavListBoxStyle。绑定 Menus、SelectedMenu。项为图标和标题。  -->
                <ListBox Grid.Column="0"
                         Width="{StaticResource NavMenuAreaWidth}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemsSource="{Binding Menus}"
                         SelectedItem="{Binding SelectedMenu}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <iconPacks:PackIconPhosphorIcons Width="{StaticResource NavIconSize}"
                                                                 Height="{StaticResource NavIconSize}"
                                                                 HorizontalAlignment="Center">
                                    <iconPacks:PackIconPhosphorIcons.Style>
                                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <Setter Property="Kind" Value="{Binding UnselectedIcon}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Kind" Value="{Binding SelectedIcon}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconPhosphorIcons.Style>
                                </iconPacks:PackIconPhosphorIcons>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{StaticResource NavLabelFontSize}"
                                           FontWeight="Bold"
                                           LineHeight="30"
                                           LineStackingStrategy="BlockLineHeight"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  控件 运行命令。样式 NavRunListBoxStyle。绑定 RunCommands、SelectedRun。整机启动、停止、刷新。  -->
                <ListBox Grid.Column="1"
                         Width="{StaticResource NavRunAreaWidth}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         ClipToBounds="True"
                         Style="{StaticResource NavRunListBoxStyle}"
                         ItemsSource="{Binding RunCommands}"
                         SelectedItem="{Binding SelectedRun}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <iconPacks:PackIconPhosphorIcons Kind="{Binding Icon}"
                                                             Width="{StaticResource NavIconSize}"
                                                             Height="{StaticResource NavIconSize}"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!--  内容区。标题跟随菜单，正文切换对应页面。  -->
        <Border Grid.Row="1"
                Background="{DynamicResource PageBackground}"
                Padding="12">
            <Grid>
            <!--<Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{DynamicResource CardBackground}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Border Width="3"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource ThemeBrushColorAssist}" />
                            <TextBlock Text="{Binding ContentTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource HighestBlack}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource HeaderDividerBrush}" />

                </Grid>
            </Border>-->
            <!--  控件 MainViewContent：当前页面。区域 MainViewContentRegion。  -->
            <Border Background="{DynamicResource CardBodyBrush}">
                <ContentControl x:Name="MainViewContent"
                                        Background="Transparent"
                                        prism:RegionManager.RegionName="MainViewContentRegion" />
            </Border>
            </Grid>
        </Border>

        <!--  区域 底栏。金色细线加主色条。左侧版本、许可证、PLC 和扫码枪连接、运行状态。右侧登录用户和时间。文字绑 MainViewModel。底栏占位不盖住这一行。  -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource ThemeBrushColorAssist}" />

            <Border Grid.Row="1" Background="{StaticResource ThemeBrushColorMajor}">
                <DockPanel Margin="12,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="White" VerticalAlignment="Center">
                            <Run Text="{DynamicResource Footer_LoginUser}" />
                            <Run Text=" " />
                            <Run Text="{Binding LoginName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="|"
                                   Margin="10,0"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="White" VerticalAlignment="Center">
                            <Run Text="{DynamicResource Footer_Time}" />
                            <Run Text=" " />
                            <Run Text="{Binding CurrentTimeText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock FontSize="12" Foreground="White" VerticalAlignment="Center">
                            <Run Text="{DynamicResource Footer_Version}" />
                            <Run Text=" " />
                            <Run Text="{Binding VersionText, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{Binding LicenseStatusText, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDeviceLinks}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="|"
                                       Margin="10,0"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding DeviceLinks}"
                                          VerticalAlignment="Center"
                                          AlternationCount="1000">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="12,0,0,0" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter Property="Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#E8E8E8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="12"
                                                       Foreground="White"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunStatusText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="|"
                                       Margin="10,0"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="White" VerticalAlignment="Center">
                                <Run Text="{DynamicResource Footer_Run}" />
                                <Run Text=" " />
                                <Run Text="{Binding RunStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  控件 MainViewFooter：底栏占位。区域 MainViewFooterRegion。不参与点击。  -->
            <ContentControl x:Name="MainViewFooter"
                            Grid.RowSpan="2"
                            Width="0"
                            Height="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Focusable="False"
                            IsHitTestVisible="False"
                            prism:RegionManager.RegionName="MainViewFooterRegion" />
        </Grid>
    </Grid>
</mah:MetroWindow>
