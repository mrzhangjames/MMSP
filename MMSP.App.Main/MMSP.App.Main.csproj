<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 程序图标 Resources\app.ico。写入 exe，任务栏和资源管理器使用。 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- 版本前三位在 ProductVersion.cs 手写。关闭确定性编译，编译器才能展开最后一位。 -->
    <Deterministic>false</Deterministic>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口 Icon 读取这份资源。与 ApplicationIcon 是同一文件。 -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="Prism.Core" Version="9.0.537" />
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MMSP.App.Shared\MMSP.App.Shared.csproj" />
    <ProjectReference Include="..\MMSP.Common.Helper\MMSP.Common.Helper.csproj" />
    <ProjectReference Include="..\MMSP.App.TemplateMatch\MMSP.App.TemplateMatch.csproj" />
    <ProjectReference Include="..\MMSP.Core.Model\MMSP.Core.Model.csproj" />
    <ProjectReference Include="..\MMSP.Plugin.Lux\MMSP.Plugin.Lux.csproj" />
    <ProjectReference Include="..\MMSP.App.WpfBase\MMSP.App.WpfBase.csproj" />
    <ProjectReference Include="..\MMSP.Service.Database\MMSP.Service.Database.csproj" />
    <ProjectReference Include="..\MMSP.Service.Device\MMSP.Service.Device.csproj" />
    <ProjectReference Include="..\MMSP.Service.Flow\MMSP.Service.Flow.csproj" />
    <ProjectReference Include="..\MMSP.Core.License\MMSP.Core.License.csproj" />
  </ItemGroup>

  <!-- 系统配置放在解决方案 Lib\Config。编译时拷到程序目录的 Config。NLog.config 单独拷到程序目录。 -->
  <ItemGroup>
    <Content Include="..\Lib\Config\**\*.*" Exclude="..\Lib\Config\NLog.config">
      <Link>Config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Lib\Config\NLog.config">
      <Link>NLog.config</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
